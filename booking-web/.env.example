DEBUG=1
SECRET_KEY=change-me-web-secret
# Must equal booking-api JWT_SIGNING_KEY
JWT_SIGNING_KEY=change-me-shared-jwt-signing-key-min-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
ALLOWED_HOSTS=localhost,127.0.0.1
API_BASE_URL=http://localhost:8000/api
# Browser-reachable URL for uploaded images served by booking-api
API_MEDIA_URL=http://localhost:8000/media/
# Set to 1 behind HTTPS (defaults to on when DEBUG=0)
COOKIE_SECURE=0
TIME_ZONE=Asia/Kolkata
CURRENCY_SYMBOL=₹
