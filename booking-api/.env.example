DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
# Shared with booking-web so it can verify access tokens. Min 32 chars.
JWT_SIGNING_KEY=change-me-shared-jwt-signing-key-min-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
ALLOWED_HOSTS=localhost,127.0.0.1,api
TIME_ZONE=Asia/Kolkata
POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
WEB_BASE_URL=http://localhost:8001
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# USE_SQLITE=1   # local tests without Postgres

# Metabase static embedding (see metabase/README.md)
METABASE_SITE_URL=http://localhost:3000
METABASE_SECRET_KEY=
METABASE_ADMIN_DASHBOARD_ID=
METABASE_DOCTOR_DASHBOARD_ID=
METABASE_EMBED_MINUTES=60

# Plotly report engine (read-only login from apps/reports/setup_reports.sql)
REPORTS_DB_USER=report_reader
REPORTS_DB_PASSWORD=ReportRead@123
REPORTS_TIMEOUT_MS=5000
REPORTS_MAX_ROWS=2000

# ClickHouse report source (fed by PeerDB CDC; see ../analytics-stack/README.md). Empty host = disabled.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_SECURE=0
CLICKHOUSE_REPORT_USER=report_reader
CLICKHOUSE_REPORT_PASSWORD=ReportRead@123
